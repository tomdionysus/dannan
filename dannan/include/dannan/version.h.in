#pragma once

// Generated by CMake from version.h.in; the number is project(dannan VERSION).

namespace dannan {

inline constexpr const char* kVersion = "@PROJECT_VERSION@";
inline constexpr int kVersionMajor = @PROJECT_VERSION_MAJOR@;
inline constexpr int kVersionMinor = @PROJECT_VERSION_MINOR@;
inline constexpr int kVersionPatch = @PROJECT_VERSION_PATCH@;

// The version this build of the library was compiled as. A hosted system
// compares it with kVersion from the headers it was built against; a
// mismatch is refused (CLAUDE.md: the contract is versioned).
const char* library_version() noexcept;

}  // namespace dannan
