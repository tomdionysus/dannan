@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost 1.87 CONFIG COMPONENTS headers)
find_dependency(OpenSSL 3 COMPONENTS Crypto SSL)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/dannanTargets.cmake")
check_required_components(dannan)
